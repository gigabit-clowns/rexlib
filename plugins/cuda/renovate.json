{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Madrid",
  "addLabels": [
    "dependencies"
  ],
  "ignorePresets": [":ignoreModulesAndTests"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "poetry": {
    "description": "Not a poetry project, but supersedes default pep manager if left enabled.",
    "enabled": false
  },
  "packageRules": [
    {
      "matchDepNames": ["python", "gigabit-clowns/.github"],
      "enabled": false
    },
    {
      "description": "A placeholder that select_cuda_major.py rewrites once per wheel, not a version this project follows",
      "matchDepNames": ["cuda-toolkit"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_cuda_fetch_boost\\(\\s*TAG (?<currentValue>\\S+)\\s+SHA256 (?<currentDigest>[0-9a-f]{64})"],
      "depNameTemplate": "boost",
      "packageNameTemplate": "boostorg/boost",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^boost-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_cuda_fetch_spdlog\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "spdlog",
      "packageNameTemplate": "gabime/spdlog",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_cuda_fetch_catch2\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "catch2",
      "packageNameTemplate": "catchorg/Catch2",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_cuda_fetch_trompeloeil\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "trompeloeil",
      "packageNameTemplate": "rollbear/trompeloeil",
      "datasourceTemplate": "github-tags"
    }
  ]
}
