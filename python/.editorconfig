root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{hpp,cpp,inl,cmake,py,pyi}]
indent_style = tab
max_line_length = 80

[CMakeLists.txt]
indent_style = tab
max_line_length = 80

[*.toml]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
