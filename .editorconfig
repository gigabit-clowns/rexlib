root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,hpp,cpp,inl,cu,cuh,cmake,dox,py,pyi}]
indent_style = tab
tab_width = 4
max_line_length = 80

[CMakeLists.txt]
indent_style = tab
tab_width = 4
max_line_length = 80

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
