{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "REXLIB_BUILD_TESTING": "ON",
        "REXLIB_CHECK_HEADERS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Debug with the address and undefined behaviour sanitizers",
      "inherits": "debug",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:detect_odr_violation=1",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    },
    {
      "name": "sanitize-thread",
      "displayName": "Debug with the thread sanitizer",
      "inherits": "debug",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer"
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      }
    },
    {
      "name": "coverage",
      "displayName": "Debug with coverage, tests run under valgrind by ctest -T MemCheck",
      "inherits": "debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "REXLIB_ENABLE_COVERAGE": "ON",
        "REXLIB_REGISTER_TESTS_PER_BINARY": "ON",
        "MEMORYCHECK_COMMAND_OPTIONS": "--leak-check=full --show-leak-kinds=all --errors-for-leak-kinds=all --error-exitcode=1 --num-callers=50",
        "MEMORYCHECK_SUPPRESSIONS_FILE": "${sourceDir}/tests/valgrind.supp"
      }
    },
    {
      "name": "docs",
      "displayName": "The Doxygen reference of the public headers",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "REXLIB_BUILD_DOCS": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "lint",
      "displayName": "Static checks: clang-tidy and the .editorconfig rules",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "REXLIB_BUILD_TESTING": "OFF",
        "REXLIB_CLANG_TIDY": "ON",
        "REXLIB_CHECK_STYLE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "configuration": "Debug"
    },
    {
      "name": "sanitize-thread",
      "configurePreset": "sanitize-thread",
      "configuration": "Debug"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "configuration": "Debug"
    },
    {
      "name": "docs",
      "configurePreset": "docs",
      "targets": ["rexlib-docs"]
    },
    {
      "name": "lint",
      "configurePreset": "lint"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "scheduleRandom": true,
        "timeout": 600
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "scheduleRandom": true,
        "timeout": 600
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "scheduleRandom": true,
        "timeout": 600
      }
    },
    {
      "name": "sanitize-thread",
      "configurePreset": "sanitize-thread",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "scheduleRandom": true,
        "timeout": 600
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "scheduleRandom": true,
        "timeout": 600
      }
    },
    {
      "name": "lint",
      "configurePreset": "lint",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
