{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Madrid",
  "addLabels": [
    "dependencies"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "ignorePresets": [":ignoreModulesAndTests"],
  "packageRules": [
    {
      "matchDepNames": ["gigabit-clowns/.github"],
      "enabled": false
    },
    {
      "description": "Security advisories bypass the 14-day delay",
      "matchUpdateTypes": ["security"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchDatasources": ["custom.half"],
      "extractVersion": "^/projects/half/files/half/(?<version>[0-9.]+)/$"
    },
    {
      "description": "A commit carries no release timestamp to age against, and strict internal checks would hold the update forever",
      "matchDatasources": ["git-refs"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ],
  "customDatasources": {
    "half": {
      "defaultRegistryUrlTemplate": "https://sourceforge.net/projects/half/files/half/",
      "format": "html"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_add_boost\\(VERSION (?<currentValue>[^\\s)]+)[^)]*\\)"],
      "depNameTemplate": "boost",
      "packageNameTemplate": "boostorg/boost",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^boost-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_add_half\\(VERSION (?<currentValue>[^\\s)]+)[^)]*\\)"],
      "depNameTemplate": "half",
      "datasourceTemplate": "custom.half"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_add_spdlog\\(VERSION (?<currentValue>[^\\s)]+)[^)]*\\)"],
      "depNameTemplate": "spdlog",
      "packageNameTemplate": "gabime/spdlog",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_add_catch2\\(VERSION (?<currentValue>[^\\s)]+)[^)]*\\)"],
      "depNameTemplate": "catch2",
      "packageNameTemplate": "catchorg/Catch2",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_add_trompeloeil\\(VERSION (?<currentValue>[^\\s)]+)[^)]*\\)"],
      "depNameTemplate": "trompeloeil",
      "packageNameTemplate": "rollbear/trompeloeil",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_add_eigen\\(VERSION (?<currentValue>[^\\s)]+)[^)]*\\)"],
      "depNameTemplate": "eigen",
      "packageNameTemplate": "libeigen/eigen",
      "datasourceTemplate": "gitlab-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_add_pocketfft\\(COMMIT (?<currentDigest>[^\\s)]+)[^)]*\\)"],
      "depNameTemplate": "pocketfft",
      "packageNameTemplate": "https://github.com/mreineck/pocketfft",
      "currentValueTemplate": "cpp",
      "datasourceTemplate": "git-refs"
    }
  ]
}
