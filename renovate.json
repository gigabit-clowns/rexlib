{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Madrid",
  "addLabels": [
    "dependencies"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "ignorePresets": [":ignoreModulesAndTests"],
  "packageRules": [
    {
      "matchDepNames": ["gigabit-clowns/.github"],
      "enabled": false
    },
    {
      "matchDatasources": ["custom.half"],
      "extractVersion": "^/projects/half/files/half/(?<version>[0-9.]+)/$"
    },
    {
      "description": "A commit carries no release timestamp to age against, and strict internal checks would hold the update forever",
      "matchDatasources": ["git-refs"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ],
  "customDatasources": {
    "half": {
      "defaultRegistryUrlTemplate": "https://sourceforge.net/projects/half/files/half/",
      "format": "html"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_fetch_boost\\(\\s*TAG (?<currentValue>\\S+)\\s+SHA256 (?<currentDigest>[0-9a-f]{64})"],
      "depNameTemplate": "boost",
      "packageNameTemplate": "boostorg/boost",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^boost-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_fetch_half\\(\\s*VERSION (?<currentValue>\\S+)"],
      "depNameTemplate": "half",
      "datasourceTemplate": "custom.half"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_fetch_spdlog\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "spdlog",
      "packageNameTemplate": "gabime/spdlog",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_fetch_pocketfft\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "pocketfft",
      "packageNameTemplate": "https://github.com/mreineck/pocketfft",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_fetch_eigen\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "eigen",
      "packageNameTemplate": "libeigen/eigen",
      "datasourceTemplate": "gitlab-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_fetch_catch2\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "catch2",
      "packageNameTemplate": "catchorg/Catch2",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib_fetch_trompeloeil\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "trompeloeil",
      "packageNameTemplate": "rollbear/trompeloeil",
      "datasourceTemplate": "github-tags"
    }
  ]
}
