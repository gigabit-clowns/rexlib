{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Madrid",
  "addLabels": [
    "dependencies"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "automerge": true,
  "ignorePresets": [":ignoreModulesAndTests"],
  "constraints": {
    "ghActionsLock": "v0.4.1"
  },
  "lockFileMaintenance": {
    "description": "Moves what uv.lock pins beyond the groups' own pins, those they pull in, to their newest releases, once a month",
    "enabled": true,
    "schedule": ["* 0-3 1 * *"]
  },
  "poetry": {
    "description": "Not a poetry project, but supersedes the pep621 manager if left enabled",
    "enabled": false
  },
  "packageRules": [
    {
      "description": "The Python versions of requires-python and of the workflows",
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "The runner images of the workflows",
      "matchDatasources": ["github-runners"],
      "enabled": false
    },
    {
      "description": "Keeps the numpy pin for Python 3.11 on releases that support 3.11; 2.5.0 raised requires-python to >=3.12",
      "matchDepNames": ["numpy"],
      "matchCurrentVersion": ">=2.3,<2.5",
      "constraints": { "python": "3.11" },
      "constraintsFiltering": "strict"
    },
    {
      "matchDatasources": ["custom.half"],
      "extractVersion": "^/projects/half/files/half/(?<version>[0-9.]+)/$"
    },
    {
      "description": "Updates from a commit or a SourceForge listing, which carry no release date, without waiting for one",
      "matchDatasources": ["git-refs", "custom.half"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Moves the vcpkg baseline once a month",
      "matchDepNames": ["vcpkg"],
      "schedule": ["* 0-3 1 * *"],
      "updateNotScheduled": false
    }
  ],
  "customDatasources": {
    "half": {
      "defaultRegistryUrlTemplate": "https://sourceforge.net/projects/half/files/half/",
      "format": "html"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib(?:_cuda|_python)?_fetch_boost\\(\\s*TAG (?<currentValue>\\S+)\\s+SHA256 (?<currentDigest>[0-9a-f]{64})"],
      "depNameTemplate": "boost",
      "packageNameTemplate": "boostorg/boost",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^boost-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib(?:_cuda|_python)?_fetch_half\\(\\s*VERSION (?<currentValue>\\S+)"],
      "depNameTemplate": "half",
      "datasourceTemplate": "custom.half"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib(?:_cuda|_python)?_fetch_spdlog\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "spdlog",
      "packageNameTemplate": "gabime/spdlog",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib(?:_cuda|_python)?_fetch_pocketfft\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "pocketfft",
      "packageNameTemplate": "https://github.com/mreineck/pocketfft",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib(?:_cuda|_python)?_fetch_eigen\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "eigen",
      "packageNameTemplate": "libeigen/eigen",
      "datasourceTemplate": "gitlab-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib(?:_cuda|_python)?_fetch_catch2\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "catch2",
      "packageNameTemplate": "catchorg/Catch2",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib(?:_cuda|_python)?_fetch_trompeloeil\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "trompeloeil",
      "packageNameTemplate": "rollbear/trompeloeil",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/CMakeLists.txt"],
      "matchStrings": ["rexlib(?:_cuda|_python)?_fetch_dlpack\\(\\s*COMMIT (?<currentDigest>[0-9a-f]{40})\\s*\\) # (?<currentValue>\\S+)"],
      "depNameTemplate": "dlpack",
      "packageNameTemplate": "dmlc/dlpack",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "The baseline of the vcpkg manifest, a commit of vcpkg's master",
      "managerFilePatterns": ["vcpkg.json"],
      "matchStrings": ["\"baseline\": \"(?<currentDigest>[0-9a-f]{40})\""],
      "depNameTemplate": "vcpkg",
      "packageNameTemplate": "https://github.com/microsoft/vcpkg",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "The gh-actions-lock extension of the Lint job, and the one Renovate regenerates actions.lock with",
      "managerFilePatterns": [".github/workflows/*.yml", "renovate.json"],
      "matchStrings": [
        "gh extension install github/gh-actions-lock --pin (?<currentValue>v\\S+)",
        "\"ghActionsLock\": \"(?<currentValue>v[^\"]+)\""
      ],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "The version of uv that writes uv.lock, which CI installs too",
      "managerFilePatterns": ["pyproject.toml"],
      "matchStrings": ["required-version = \"==(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    }
  ]
}
